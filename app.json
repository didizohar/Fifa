{
  "expo": {
    "name": "FC Rival",
    "slug": "fc-rival",
    "scheme": "fcrival",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fcrival.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "FC Rival needs access to your photos so you can set a player's avatar."
      }
    },
    "android": {
      "package": "com.fcrival.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0D0B"
      }
    },
    "extra": {
      "eas": {
        "projectId": "2230efa2-657c-4678-897d-e34ebe9cd7a0"
      },
      "router": {}
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0A0D0B"
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "FC Rival needs access to your photos so you can set a player's avatar.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "owner": "didizzz"
  }
}
